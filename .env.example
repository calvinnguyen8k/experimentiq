# Copy to backend/.env. Never put this secret in frontend/.env.local.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
# Optional operator-maintained USD prices per million tokens. Omit for null estimate.
# INPUT_COST_PER_MILLION=0.40
# OUTPUT_COST_PER_MILLION=1.60
